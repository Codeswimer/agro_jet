# =============================================================================
# AGRO JET backend environment variables
# Copy to .env for local use, or paste into Vercel project settings in prod.
# =============================================================================

# --- Core (REQUIRED in production) ---
DJANGO_SECRET_KEY=generate-a-50-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost

# --- Database (REQUIRED in production) — Neon Postgres connection string ---
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Use the POOLED connection string (port 6543) for serverless.
DATABASE_URL=postgresql://user:password@ep-cool-name-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Security (production) ---
DJANGO_SECURE_SSL_REDIRECT=1

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://agrojet.vercel.app

# --- CSRF: trusted origins for the Django admin ---
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,https://agrojet.vercel.app

# --- JWT lifetimes (optional) ---
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7
